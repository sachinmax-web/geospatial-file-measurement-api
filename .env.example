# Database Configuration
# Local SQLite fallback: sqlite:///./geospatial.db
# PostgreSQL / PostGIS: postgresql://postgres:postgres_password@localhost:5432/geospatial_db
DATABASE_URL=sqlite:///./geospatial.db

# Storage & Limits
MAX_FILE_SIZE_BYTES=52428800
UPLOAD_DIRECTORY=./uploads

# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Settings for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=geospatial_db
